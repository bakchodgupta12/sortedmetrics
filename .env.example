# Copy to .env and fill in your Supabase project values.
# Find these in the Supabase dashboard: Project Settings → API.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY (used by /api serverless functions, never bundled to the browser).
# Do NOT prefix these with REACT_APP_. Set them in Vercel → Project Settings →
# Environment Variables (and locally for `vercel dev`).
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
